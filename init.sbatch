#!/bin/bash
#SBATCH --job-name=condiv_init
#SBATCH --account=pi-trsosnic
#SBATCH --partition=caslake
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=00:05:00
#SBATCH --mail-user=okleinmann@rcc.uchicago.edu
#SBATCH --mail-type=ALL
#SBATCH --output=condiv_init_%j.out
#SBATCH --error=condiv_init_%j.err

export MKL_THREADING_LAYER=GNU
export UPSIDE_HOME=/home/okleinmann/upside2-md/py3/
export THEANO_FLAGS='blas.ldflags='

X=`pwd`
Y=condiv_training_results

mode=initialize
initial_param=init_param   # initial parameters.
upside_input_dir=condiv_training_proteins     # directory created by setup_condiv_training.py containing .initial.npy, .fasta, and .chi files
pdb_list=condiv_training_proteins/protein_list.txt      # protein list generated by setup_condiv_training.py

source ~/miniconda3/etc/profile.d/conda.sh
conda activate condiv-env

echo python condiv2.py $mode $initial_param $upside_input_dir $pdb_list $Y
python condiv2.py $mode $initial_param $upside_input_dir $pdb_list $Y | tee /$Y.output
